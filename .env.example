# Copy to .env and adjust. Everything optional is OFF by default.

# A long random string. If left empty, one is generated and kept in the data volume.
SECRET_KEY=

# Set to true once you serve FinVault over HTTPS (for example behind Caddy or Traefik).
COOKIE_SECURE=false
SESSION_HOURS=12

# Who can sign up after the first (admin) account: open | invite | closed
REGISTRATION_MODE=invite
DEFAULT_CURRENCY=CAD

# Leave empty to use the built-in SQLite file in the data volume.
# DATABASE_URL=postgresql+psycopg://finvault:finvault@db/finvault

# --- Optional bank sync (never used for Canadian accounts) --------------------
BANK_SYNC_ENABLED=false
# Europe, PSD2 (GoCardless Bank Account Data)
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# Brazil (Pluggy)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# United States (SimpleFIN Bridge; each user brings their own setup token)
SIMPLEFIN_ENABLED=false
SYNC_INTERVAL_HOURS=12

# --- Optional AI chat (admin enables it, then each user opts in) --------------
AI_ENABLED=false
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=llama3.1
AI_API_KEY=

# --- Optional exchange-rate fetching (ECB rates; sends only currency codes) ----
FX_FETCH_ENABLED=false

# --- Watched import folder (admin toggle; docker-compose mounts ./inbox) ------
FOLDER_IMPORT_ENABLED=false
# IMPORT_WATCH_DIR=/inbox

# --- Receipt text reading with Tesseract on this server ------------------------
OCR_ENABLED=false

# --- Email for bill reminders (optional; ntfy push needs no server setup) -------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Encrypted backups (the admin turns them on and sets the passphrase in Admin) ---
# Default for the admin toggle. Backups also need a passphrase set in the app.
BACKUP_ENABLED=false
# Where .fvbackup files go. Mount your NAS share here. Default: <data>/backups
# BACKUP_DIR=/backups
# How many backups to keep (in the folder and in S3). The admin can change it in the app.
BACKUP_KEEP=14
# The nightly backup runs at the first hourly check at or after this hour (server local time).
BACKUP_HOUR=3
# Optional S3-compatible copy (MinIO, Backblaze B2, Cloudflare R2, Wasabi, AWS). Files are
# encrypted before they leave the server. Path-style URLs: <endpoint>/<bucket>/<prefix><file>.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=finvault/
BACKUP_S3_REGION=us-east-1

# --- Single sign-on with OpenID Connect (Authentik, Pocket ID, Keycloak, ...) -------
OIDC_ENABLED=false
# Shown on the button: "Sign in with <name>"
OIDC_PROVIDER_NAME=SSO
# The provider's /.well-known/openid-configuration URL
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Register this as the redirect URI at the provider. Empty means <this server's origin>/api/auth/oidc/callback.
# Set it explicitly when FinVault runs behind a reverse proxy.
# OIDC_REDIRECT_URI=https://finvault.example.lan/api/auth/oidc/callback
# false: only existing members, matched by verified email, can sign in.
# true: new people get an account too, still following REGISTRATION_MODE (invite links work).
OIDC_ALLOW_SIGNUP=false
# OIDC_SCOPES=openid email profile
# Leave on. Turn off only if your provider never sends email_verified and you control every account on it.
OIDC_REQUIRE_VERIFIED_EMAIL=true
# Set to false to hide the password form and allow single sign-on only.
LOCAL_AUTH_ENABLED=true

# --- Audit log ------------------------------------------------------------------------
# Older security events are deleted by the nightly job.
AUDIT_RETENTION_DAYS=365
