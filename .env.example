# Copy to .env and adjust. Everything optional is OFF by default.

# A long random string. If left empty, one is generated and kept in the data volume.
SECRET_KEY=

# Set to true once you serve FinVault over HTTPS (for example behind Caddy or Traefik).
COOKIE_SECURE=false
SESSION_HOURS=12
# If FinVault sits behind a reverse proxy, set this to the proxy IP/CIDR so Uvicorn trusts X-Forwarded-* headers.
# FORWARDED_ALLOW_IPS=127.0.0.1
# Set true only if you intentionally send webhooks/provider callbacks to LAN services such as a private ntfy server.
ALLOW_PRIVATE_OUTBOUND_URLS=false

# Who can sign up after the first (admin) account: open | invite | closed
REGISTRATION_MODE=invite
DEFAULT_CURRENCY=CAD

# Leave empty to use the built-in SQLite file in the data volume.
# DATABASE_URL=postgresql+psycopg://finvault:finvault@db/finvault

# --- Optional bank sync (never used for Canadian accounts) --------------------
BANK_SYNC_ENABLED=false
# Europe, PSD2 (GoCardless Bank Account Data)
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# Brazil (Pluggy)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# United States (SimpleFIN Bridge; each user brings their own setup token)
SIMPLEFIN_ENABLED=false
SYNC_INTERVAL_HOURS=12

# --- Optional AI chat (admin enables it, then each user opts in) --------------
AI_ENABLED=false
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=llama3.1
AI_API_KEY=

# --- Optional exchange-rate fetching (ECB rates; sends only currency codes) ----
FX_FETCH_ENABLED=false

# --- Watched import folder (admin toggle; docker-compose mounts ./inbox) ------
FOLDER_IMPORT_ENABLED=false
# IMPORT_WATCH_DIR=/inbox

# --- Receipt text reading with Tesseract on this server ------------------------
OCR_ENABLED=false

# --- Email for bill reminders (optional; ntfy push needs no server setup) -------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
